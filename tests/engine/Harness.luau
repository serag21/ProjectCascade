--!nocheck
-- Shared scenario helpers: boot the real game sources inside FakeRoblox and
-- drive players through the real RemoteEvents. Sources.luau is generated by
-- tests/test_spark_headless.py from game/** at run time.
local Fake = require("./FakeRoblox")
local Sources = require("./Sources")
local Harness = {}
local DT = require("./Datatypes")
Harness.Vector3, Harness.CFrame, Harness.Color3 = DT.Vector3, DT.CFrame, DT.Color3

local checks = 0
function Harness.check(ok, message)
	checks += 1
	if not ok then error("CHECK FAILED: " .. tostring(message), 2) end
end
function Harness.count() return checks end

function Harness.boot(options)
	options = options or {}
	local engine = Fake.new({studio = options.studio ~= false, echo = options.echo})
	engine.mount(Sources)
	engine.startServer()
	-- World.build (3 arenas + Trial Grounds) and herd seeding yield across frames.
	engine.advance(options.bootSeconds or 2)
	local h = {engine = engine, states = {}, feedback = {}}
	local rs = engine.service("ReplicatedStorage")
	local shared = rs:FindFirstChild("Spark")
	h.remotes = shared and shared:FindFirstChild("Remotes")
	h.world = engine.workspace:FindFirstChild("SparkWorld")
	return setmetatable(h, {__index = Harness})
end

-- HerdNet packets (server stops moving creature models; clients render them).
-- The harness plays the client's role for scenario bots: it applies the latest
-- snapshot per arena to the shared fake models so GetPivot() follows the herd.
function Harness.decodeHerd(packet)
	if type(packet) ~= "buffer" or buffer.len(packet) < 8 then return nil end
	local count = buffer.readu16(packet, 2)
	if buffer.len(packet) ~= 8 + count * 10 then return nil end
	local out = {arena = buffer.readu8(packet, 1), clock = buffer.readf32(packet, 4), entries = {}}
	for i = 0, count - 1 do
		local o = 8 + i * 10
		table.insert(out.entries, {id = buffer.readu32(packet, o), x = buffer.readi16(packet, o + 4) / 10,
			z = buffer.readi16(packet, o + 6) / 10, flags = buffer.readu8(packet, o + 9)})
	end
	return out
end
function Harness.applyHerd(h, packets)
	if not h.world then return end
	local byId = {}
	for _, model in ipairs(h.world.Creatures:GetChildren()) do
		local id = model:GetAttribute("CreatureId")
		if id then byId[id] = model end
	end
	for _, packet in pairs(packets) do
		local decoded = Harness.decodeHerd(packet)
		if decoded then
			local originX = (decoded.arena - 1) * 300
			for _, entry in ipairs(decoded.entries) do
				local model = byId[entry.id]
				if model and model.Parent then model:PivotTo(DT.CFrame.new(originX + entry.x, 2.2, entry.z)) end
			end
		end
	end
end

-- Latest server->client payloads, recorded from the FireClient log.
function Harness.collect(h)
	local log = h.engine.remoteLog
	local last = h.lastSeq or 0
	local start = #log + 1
	while start > 1 and log[start - 1].seq > last do start -= 1 end
	local herd = {}
	for i = start, #log do
		local entry = log[i]
		local userId = entry.player.UserId
		if entry.remote == "HerdNet" then
			local packet = entry.args[1]
			if type(packet) == "buffer" and buffer.len(packet) >= 2 then
				herd[buffer.readu8(packet, 1)] = packet
				h.herdPackets = (h.herdPackets or 0) + 1
				h.herdBytes = (h.herdBytes or 0) + buffer.len(packet)
			end
		elseif entry.remote == "State" then
			local data = entry.args[1]
			local previous = h.states[userId]
			-- The server omits the profile when unchanged; keep the client's cached copy.
			if data.profile == nil and previous then data.profile = previous.profile end
			h.states[userId] = data
		elseif entry.remote == "Feedback" then
			h.feedback[userId] = h.feedback[userId] or {}
			table.insert(h.feedback[userId], entry.args[1])
		end
	end
	if #log > 0 then h.lastSeq = log[#log].seq end
	h:applyHerd(herd)
end
function Harness.state(h, player) h:collect(); return h.states[player.UserId] end
function Harness.feedbackOf(h, player, kind)
	h:collect()
	local list = {}
	for _, f in ipairs(h.feedback[player.UserId] or {}) do if kind == nil or f.kind == kind then table.insert(list, f) end end
	return list
end

function Harness.send(h, player, action, payload)
	h.engine.clientFire(player, h.remotes.Action, action, payload)
end

function Harness.join(h, userId, options)
	options = options or {}
	local player = h.engine.addPlayer(userId)
	h.engine.spawnCharacter(player, options.position)
	h.engine.advance(0.4)
	h:send(player, "Ready")
	h.engine.advance(0.5)
	return player
end

function Harness.root(h, player) return h.engine.root(player) end
function Harness.position(h, player) return h.engine.root(player).Position end

-- Walk (no physics) toward a world position at a plausible speed while time runs.
function Harness.walkTo(h, player, target, maxSeconds, speed)
	local arrived = false
	local elapsed = 0
	while not arrived and elapsed < (maxSeconds or 10) do
		local dt = 1 / 30
		arrived = h.engine.walkToward(player, target, speed or 20, dt)
		h.engine.step(dt)
		elapsed += dt
	end
	return arrived
end

-- Nearest creature model (optionally filtered) to a position.
function Harness.creatures(h, filter)
	local list = {}
	local folder = h.world and h.world:FindFirstChild("Creatures")
	if not folder then return list end
	for _, model in ipairs(folder:GetChildren()) do
		if not filter or filter(model) then table.insert(list, model) end
	end
	return list
end
function Harness.nearest(h, position, filter)
	local best, bestDistance = nil, math.huge
	for _, model in ipairs(h:creatures(filter)) do
		local d = (model:GetPivot().Position - position).Magnitude
		if d < bestDistance then best, bestDistance = model, d end
	end
	return best, bestDistance
end

-- Chase the nearest eligible creature and press Capture when close and facing.
function Harness.chaseAndCatch(h, player, filter, seconds)
	local started = h.engine.now
	while h.engine.now - started < (seconds or 8) do
		local here = h:position(player)
		local target = h:nearest(here, filter)
		if not target then h.engine.advance(0.2); continue end
		local goal = target:GetPivot().Position
		h.engine.walkToward(player, goal, 21, 1 / 30)
		h.engine.step(1 / 30)
		if (h:position(player) - goal).Magnitude < 3.5 then
			local carry = (h:state(player) or {}).carry or 0
			h:send(player, "Capture")
			h.engine.advance(0.1)
			local after = (h:state(player) or {}).carry or 0
			if after > carry then return true end
			h.engine.advance(0.6)
		end
	end
	return false
end

-- Scripted (non-human) bot: chase the nearest catchable Spark in the player's
-- arena, press Capture when close, Dash toward mid-range targets, bank when
-- the parade is large or the buzzer is near. Runs until Results or timeout.
function Harness.playRound(h, player, options)
	return h:playRounds({player}, options)[player]
end
-- Several bots act each frame (interleaved), so contention is real.
function Harness.playRounds(h, playerList, options)
	options = options or {}
	local e = h.engine
	local bots = {}
	for _, player in ipairs(playerList) do
		bots[player] = {captures = 0, dashes = 0, banks = 0, attempts = 0, lastCapture = -10, lastDash = -10, done = false}
	end
	local deadline = e.now + (options.timeout or 120)
	while e.now < deadline do
		local active = false
		for _, player in ipairs(playerList) do
			local bot = bots[player]
			local s = player.Parent and h:state(player)
			if not s or s.phase ~= "Playing" or bot.done then
				if s and s.phase == "Results" then bot.done = true end
				continue
			end
			if options.stopFor and options.stopFor(player, e.now) then bot.done = true; continue end
			active = true
			local origin = Harness.Vector3.new((s.biome - 1) * 300, 0, 0)
			local here = h:position(player)
			local bank = s.bankPosition
			local goal
			if s.carry > 0 and (s.carry >= math.min(options.bankAt or 6, s.capacity) or s.remaining <= 14) then
				goal = Harness.Vector3.new(bank.X, 3, bank.Z - 3)
			else
				local target = h:nearest(here, function(m)
					local owner = m:GetAttribute("StarterOwnerId")
					local position = m:GetPivot().Position
					return (owner == nil or owner == player.UserId) and math.abs(position.X - origin.X) < 60
				end)
				if target then
					goal = target:GetPivot().Position
					local distance = (goal - here).Magnitude
					if distance < 3.5 and e.now - bot.lastCapture > 0.7 then
						h:send(player, "Capture"); bot.lastCapture = e.now; bot.attempts += 1
					elseif distance > 7 and distance < 14 and e.now - bot.lastDash > (s.dashCooldown or 3) + 0.1 and options.dash ~= false then
						h:send(player, "Dash"); bot.lastDash = e.now; bot.dashes += 1
					end
				else
					goal = origin
				end
			end
			bot.wasCarry = s.carry
			e.walkToward(player, Harness.Vector3.new(goal.X, 3, goal.Z), options.speed or 21, 1 / 30)
		end
		if not active then
			if options.debug then
				for _, player in ipairs(playerList) do
					local st = h:state(player)
					print("DEBUG exit", player.Name, st and st.phase, st and st.remaining, bots[player].done, e.now)
				end
			end
			break
		end
		e.step(1 / 30)
		for _, player in ipairs(playerList) do
			local bot = bots[player]
			local s = player.Parent and h:state(player)
			if s and bot.wasCarry then
				if s.carry > bot.wasCarry then bot.captures += s.carry - bot.wasCarry end
				if bot.wasCarry > 0 and s.carry == 0 and s.phase == "Playing" then bot.banks += 1 end
			end
			bot.wasCarry = nil
		end
	end
	return bots
end

-- Synchronized cycles: rounds auto-start at the next shared cycle boundary.
-- Advance virtual time until every listed player is in a scored round.
function Harness.awaitPlaying(h, playerList, timeout)
	local e = h.engine
	local deadline = e.now + (timeout or 20)
	while e.now < deadline do
		local all = true
		for _, player in ipairs(playerList) do
			local s = h:state(player)
			if not s or s.phase ~= "Playing" then all = false end
		end
		if all then return true end
		e.step(1 / 10)
	end
	return false
end

function Harness.assertClean(h, label)
	local e = h.engine
	-- Non-finite world geometry is always a defect (server math or harness).
	if h.world then
		for _, d in ipairs(h.world:GetDescendants()) do
			if d:IsA("BasePart") then
				local p = d.Position
				if p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or math.abs(p.X) == math.huge then
					error((label or "scenario") .. ": non-finite position on " .. d:GetFullName(), 2)
				end
			end
		end
	end
	if #e.errors > 0 then
		for _, message in ipairs(e.errors) do print("ENGINE ERROR: " .. message) end
		error((label or "scenario") .. ": " .. #e.errors .. " engine/script errors", 2)
	end
end

function Harness.report(h, label)
	local e = h.engine
	print(string.format("INFO %s: t=%.1fs instances=%d created=%d destroyed=%d warnings=%d remoteIssues=%d analytics=%d",
		label, e.now, e.countInstances(), e.created, e.destroyedCount, #e.warnings, #e.remoteIssues, #e.analytics))
	for _, w in ipairs(e.warnings) do print("WARN " .. w) end
	for _, issue in ipairs(e.remoteIssues) do print("REMOTE " .. issue) end
end

return Harness
