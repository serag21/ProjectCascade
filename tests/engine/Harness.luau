--!nocheck
-- Shared scenario helpers: boot the real game sources inside FakeRoblox and
-- drive players through the real RemoteEvents. Sources.luau is generated by
-- tests/test_spark_headless.py from game/** at run time.
local Fake = require("./FakeRoblox")
local Sources = require("./Sources")
local Harness = {}
local DT = require("./Datatypes")
Harness.Vector3, Harness.CFrame, Harness.Color3 = DT.Vector3, DT.CFrame, DT.Color3

local checks = 0
function Harness.check(ok, message)
	checks += 1
	if not ok then error("CHECK FAILED: " .. tostring(message), 2) end
end
function Harness.count() return checks end

function Harness.boot(options)
	options = options or {}
	local engine = Fake.new({studio = options.studio ~= false, echo = options.echo})
	engine.mount(Sources)
	engine.startServer()
	-- World.build (3 arenas + Trial Grounds) and herd seeding yield across frames.
	engine.advance(options.bootSeconds or 2)
	local h = {engine = engine, states = {}, feedback = {}, latestHerdClock = {}}
	Harness.herdNet = engine.requireSource("ReplicatedStorage/Spark/HerdNet.luau")
	local rs = engine.service("ReplicatedStorage")
	local shared = rs:FindFirstChild("Spark")
	h.remotes = shared and shared:FindFirstChild("Remotes")
	h.world = engine.workspace:FindFirstChild("SparkWorld")
	return setmetatable(h, {__index = Harness})
end

-- HerdNet v2 (WP-06): the server creates no creature Instances. The harness
-- decodes the packets each player receives (real HerdNet module) and exposes
-- lightweight pseudo-models so scenario bots can target creatures as before.
function Harness.decodeHerd(packet, h)
	local HerdNet = Harness.herdNet
	if not HerdNet then return nil end
	return HerdNet.unpack(packet)
end
function Harness.applyHerd(_h, _packets) end
local Pseudo = {}
Pseudo.__index = Pseudo
function Pseudo:GetPivot() return self.cf end
function Pseudo:GetAttribute(name) return self.attrs[name] end
function Pseudo:IsA(name) return name == "Model" end
local function pseudo(h, id)
	h.pseudo = h.pseudo or {}
	local m = h.pseudo[id]
	if not m then
		m = setmetatable({attrs = {CreatureId = id}, cf = Harness.CFrame.new(0, 0, 0), Parent = nil, Name = "Spark_" .. id}, Pseudo)
		h.pseudo[id] = m
	end
	return m
end
-- Apply one received packet (like a client): creatures persist 1.0 s after their
-- id stops arriving, and leave at once when a Loop result lists them.
function Harness.ingestHerd(h, userId, packet)
	local HerdNet = Harness.herdNet
	local decoded = HerdNet.unpack(packet)
	if not decoded then return end
	local originX = (decoded.arena - 1) * 300
	h.herdSeen = h.herdSeen or {}
	for _, entry in ipairs(decoded.entries) do
		local m = pseudo(h, entry.id)
		h.herdSeen[entry.id] = h.engine.now
		m.cf = Harness.CFrame.new(originX + entry.x, 2.2 + (entry.height or 0), entry.z)
		m.attrs.Species = entry.species
		m.attrs.State = entry.state
		m.attrs.Golden = HerdNet.has(entry.flags, "golden") or nil
		m.attrs.Dazed = HerdNet.has(entry.flags, "dazed") or nil
		m.attrs.Fleeing = HerdNet.has(entry.flags, "fleeing") or nil
		if HerdNet.has(entry.flags, "private") then m.attrs.StarterOwnerId = userId end
		m.attrs.Trial = HerdNet.has(entry.flags, "trial") or nil
		m.Parent = h.world
	end
end
function Harness.forgetCreature(h, id)
	if h.pseudo and h.pseudo[id] then h.pseudo[id].Parent = nil; h.pseudo[id] = nil end
	if h.herdSeen then h.herdSeen[id] = nil end
end
function Harness.refreshHerd(h)
	local now = h.engine.now
	for id, at in pairs(h.herdSeen or {}) do
		if now - at > 1.0 then h:forgetCreature(id) end
	end
end

-- Latest server->client payloads, recorded from the FireClient log.
function Harness.collect(h)
	local log = h.engine.remoteLog
	local last = h.lastSeq or 0
	local start = #log + 1
	while start > 1 and log[start - 1].seq > last do start -= 1 end
	local herd = {}
	for i = start, #log do
		local entry = log[i]
		local userId = entry.player.UserId
		if entry.remote == "HerdNet" then
			local packet = entry.args[1]
			if type(packet) == "buffer" and buffer.len(packet) >= 2 then
				herd[buffer.readu8(packet, 1)] = packet
				h.latestHerd = h.latestHerd or {}
				h.latestHerd[buffer.readu8(packet, 1)] = packet
				-- One packet list per player per tick (a tick is one clock value).
				h.latestHerdBy = h.latestHerdBy or {}
				local clock = buffer.readf32(packet, 4)
				local list = h.latestHerdBy[userId]
				if not list or h.latestHerdClock[userId] ~= clock then
					list = {}; h.latestHerdBy[userId] = list; h.latestHerdClock[userId] = clock
				end
				table.insert(list, packet)
				h:ingestHerd(userId, packet)
				h.herdPackets = (h.herdPackets or 0) + 1
				h.herdBytes = (h.herdBytes or 0) + buffer.len(packet)
				h.herdBytesBy = h.herdBytesBy or {}
				h.herdBytesBy[userId] = (h.herdBytesBy[userId] or 0) + buffer.len(packet)
			end
		elseif entry.remote == "State" then
			-- Copy, never mutate the logged payload: traffic measurements read the log.
			local data = table.clone(entry.args[1])
			local previous = h.states[userId]
			-- The server omits the profile when unchanged; keep the client's cached copy.
			if data.profile == nil and previous then data.profile = previous.profile end
			-- Like the client: blocks sent only on change are merged from the last copy.
			if previous then
				for _, key in ipairs({"trial", "stats", "remix"}) do
					if data[key] == nil then data[key] = previous[key] end
				end
				if type(data.trial) == "table" and data.trial.board == nil and type(previous.trial) == "table" and previous.trial.board then
					data.trial = table.clone(data.trial); data.trial.board = previous.trial.board
				end
			end
			h.states[userId] = data
		elseif entry.remote == "Feedback" then
			h.feedback[userId] = h.feedback[userId] or {}
			table.insert(h.feedback[userId], entry.args[1])
			local f = entry.args[1]
			if type(f) == "table" and f.kind == "Loop" and type(f.extra) == "table" and type(f.extra.caught) == "table" then
				for _, c in ipairs(f.extra.caught) do h:forgetCreature(c.creatureId) end
			end
		end
	end
	if #log > 0 then h.lastSeq = log[#log].seq end
	h:refreshHerd()
end
function Harness.state(h, player) h:collect(); return h.states[player.UserId] end
function Harness.feedbackOf(h, player, kind)
	h:collect()
	local list = {}
	for _, f in ipairs(h.feedback[player.UserId] or {}) do if kind == nil or f.kind == kind then table.insert(list, f) end end
	return list
end

function Harness.send(h, player, action, payload)
	h.engine.clientFire(player, h.remotes.Action, action, payload)
end

function Harness.join(h, userId, options)
	options = options or {}
	local player = h.engine.addPlayer(userId)
	h.engine.spawnCharacter(player, options.position)
	h.engine.advance(0.4)
	h:send(player, "Ready")
	h.engine.advance(0.5)
	return player
end

function Harness.root(h, player) return h.engine.root(player) end
function Harness.position(h, player) return h.engine.root(player).Position end

-- Walk (no physics) toward a world position at a plausible speed while time runs.
function Harness.walkTo(h, player, target, maxSeconds, speed)
	local arrived = false
	local elapsed = 0
	while not arrived and elapsed < (maxSeconds or 10) do
		local dt = 1 / 30
		arrived = h.engine.walkToward(player, target, speed or 20, dt)
		h.engine.step(dt)
		elapsed += dt
	end
	return arrived
end

-- Nearest creature model (optionally filtered) to a position.
function Harness.creatures(h, filter)
	h:collect()
	local list = {}
	local ids = {}
	for id in pairs(h.pseudo or {}) do table.insert(ids, id) end
	table.sort(ids)
	for _, id in ipairs(ids) do
		local model = h.pseudo[id]
		if not filter or filter(model) then table.insert(list, model) end
	end
	return list
end
function Harness.nearest(h, position, filter)
	local best, bestDistance = nil, math.huge
	for _, model in ipairs(h:creatures(filter)) do
		local d = (model:GetPivot().Position - position).Magnitude
		if d < bestDistance then best, bestDistance = model, d end
	end
	return best, bestDistance
end

-- Loop tools (WP-04): the harness plays the client's role with the REAL Loop
-- module: a local ribbon from the bot's positions, tryClose with the live head,
-- and the same claim payload the client sends (polygon, kind, viewClock).
function Harness.loopKit(h)
	if not h.Loop then
		h.Loop = h.engine.requireSource("ReplicatedStorage/Spark/Loop.luau")
		h.DesignTuning = h.engine.requireSource("ReplicatedStorage/Spark/Design/Tuning.luau")
		h.LoopT = h.Loop.tuning(h.DesignTuning)
	end
	return h.Loop, h.LoopT
end
-- The herd clock a client would be rendering (latest snapshot - 0.1 s).
function Harness.viewClock(h, arena)
	h:collect()
	local packet = h.latestHerd and h.latestHerd[arena or 1]
	local decoded = packet and Harness.herdNet.unpack(packet)
	return if decoded then decoded.clock - 0.1 else 0
end
-- Per-bot ribbon state.
function Harness.ribbonFor(h, player)
	h.ribbons = h.ribbons or {}
	local Loop = h:loopKit()
	if not h.ribbons[player] then h.ribbons[player] = {ribbon = Loop.new(), claims = 0} end
	return h.ribbons[player]
end
-- Feed the current position into the bot's ribbon; on closure send the claim.
-- Returns the polygon when a claim was sent.
function Harness.ribbonStep(h, player, arena)
	local Loop, T = h:loopKit()
	local r = h:ribbonFor(player)
	local pos = h:position(player)
	local origin = Harness.Vector3.new(((arena or 1) - 1) * 300, 0, 0)
	local x, z = pos.X - origin.X, pos.Z - origin.Z
	local now = h.engine.now
	Loop.push(r.ribbon, x, z, now, T, 0)
	local poly, kind = Loop.tryClose(r.ribbon, T, {x = x, z = z, t = now, g = 0})
	if poly then
		r.claims += 1
		h:send(player, "Loop", {poly = Loop.encode(poly), kind = kind, viewClock = h:viewClock(arena)})
		r.ribbon = Loop.new()
		Loop.push(r.ribbon, x, z, now, T, 0)
		return poly
	end
	return nil
end
-- Walk a circle of `radius` around `center` (world Vector3) for up to `turns`,
-- drawing the ribbon; stops at the first closure. -> polygon or nil.
function Harness.ringAround(h, player, center, radius, options)
	options = options or {}
	local e = h.engine
	local here = h:position(player)
	local angle = math.atan2(here.Z - center.Z, here.X - center.X)
	local start = center + Harness.Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
	h:walkTo(player, Harness.Vector3.new(start.X, 3, start.Z), 6, options.speed or 21)
	h:ribbonFor(player).ribbon = h.Loop.new()
	local speed, dt = options.speed or 21, 1 / 30
	local swept = 0
	while swept < (options.turns or 1.3) * math.pi * 2 do
		local step = speed * dt / radius
		angle += step * (options.direction or 1); swept += step
		local target = center + Harness.Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		e.walkToward(player, Harness.Vector3.new(target.X, 3, target.Z), speed * 1.05, dt)
		e.step(dt)
		local poly = h:ribbonStep(player, options.arena)
		if poly then
			e.advance(options.settle or 0.45)
			return poly
		end
	end
	return nil
end
-- Two players walk the same ring from opposite sides; each sends its claim as
-- soon as its own ribbon closes. -> polygonA, polygonB (either may be nil).
function Harness.pairRing(h, a, b, centre, radius, arena)
	local e = h.engine
	local Loop = h:loopKit()
	h:walkTo(a, Harness.Vector3.new(centre.X + radius, 3, centre.Z), 6)
	h:walkTo(b, Harness.Vector3.new(centre.X - radius, 3, centre.Z), 6)
	h:ribbonFor(a).ribbon = Loop.new(); h:ribbonFor(b).ribbon = Loop.new()
	local angleA, angleB, dt = 0, math.pi, 1 / 30
	local sentA, sentB
	for _ = 1, 200 do
		angleA += 21 * dt / radius; angleB += 21 * dt / radius
		e.walkToward(a, Harness.Vector3.new(centre.X + math.cos(angleA) * radius, 3, centre.Z + math.sin(angleA) * radius), 22, dt)
		e.walkToward(b, Harness.Vector3.new(centre.X + math.cos(angleB) * radius, 3, centre.Z + math.sin(angleB) * radius), 22, dt)
		e.step(dt)
		if not sentA then sentA = h:ribbonStep(a, arena or 1) end
		if not sentB then sentB = h:ribbonStep(b, arena or 1) end
		if sentA and sentB then break end
	end
	return sentA, sentB
end

-- Loop results (feedback kind "Loop") received since index `from`.
function Harness.loopResults(h, player, from)
	local list = {}
	for index, f in ipairs(h:feedbackOf(player, "Loop")) do
		if index > (from or 0) then table.insert(list, f) end
	end
	return list
end
-- Run through a bank ring (world position of its centre).
function Harness.runThroughRing(h, player, ring, options)
	options = options or {}
	local approach = ring + Harness.Vector3.new(0, 0, options.from or 6)
	h:walkTo(player, Harness.Vector3.new(approach.X, 3, approach.Z), 8)
	return h:walkTo(player, Harness.Vector3.new(ring.X, 3, ring.Z - (options.from or 6)), 4)
end

-- Scripted (non-human) bot (WP-04 loop version): approach the nearest catchable
-- Spark, walk a ring around it (real Loop ribbon + claims), dash occasionally,
-- and bank by running through the arena's bank ring when the parade is large or
-- the buzzer is near. Runs until Results or timeout. Not human timing.
function Harness.playRound(h, player, options)
	return h:playRounds({player}, options)[player]
end
-- Several bots act each frame (interleaved), so contention is real.
function Harness.playRounds(h, playerList, options)
	options = options or {}
	local e = h.engine
	h:loopKit()
	local bots = {}
	for _, player in ipairs(playerList) do
		bots[player] = {captures = 0, dashes = 0, banks = 0, attempts = 0, loops = 0, lastDash = -10, done = false, mode = "seek"}
	end
	local radius = options.radius or 5.5
	local deadline = e.now + (options.timeout or 120)
	local dt = 1 / 30
	while e.now < deadline do
		local active = false
		for _, player in ipairs(playerList) do
			local bot = bots[player]
			local s = player.Parent and h:state(player)
			if not s or s.phase ~= "Playing" or bot.done then
				if s and s.phase == "Results" then bot.done = true end
				continue
			end
			if options.stopFor and options.stopFor(player, e.now) then bot.done = true; continue end
			active = true
			local origin = Harness.Vector3.new((s.biome - 1) * 300, 0, 0)
			local here = h:position(player)
			local bank = s.bankPosition
			local goal
			local wantBank = s.carry > 0 and (s.carry >= math.min(options.bankAt or 6, s.capacity) or s.remaining <= 14)
			if wantBank and bot.mode ~= "bank2" then
				-- Approach from the south side, then run north through the ring.
				if bot.mode ~= "bank" then bot.mode = "bank" end
				goal = Harness.Vector3.new(bank.X, 3, bank.Z + 7)
				if (Harness.Vector3.new(here.X, 0, here.Z) - Harness.Vector3.new(goal.X, 0, goal.Z)).Magnitude < 1.5 then bot.mode = "bank2" end
			elseif bot.mode == "bank2" then
				goal = Harness.Vector3.new(bank.X, 3, bank.Z - 7)
				if s.carry == 0 or (Harness.Vector3.new(here.X, 0, here.Z) - Harness.Vector3.new(goal.X, 0, goal.Z)).Magnitude < 1.5 then bot.mode = "seek" end
			elseif bot.mode == "circle" then
				bot.angle += 21 * dt / radius; bot.swept += 21 * dt / radius
				goal = bot.center + Harness.Vector3.new(math.cos(bot.angle) * radius, 0, math.sin(bot.angle) * radius)
				if bot.swept > math.pi * 2 * 1.6 then bot.mode = "seek" end
			else
				local target = h:nearest(here, function(m)
					local owner = m:GetAttribute("StarterOwnerId")
					local position = m:GetPivot().Position
					return (owner == nil or owner == player.UserId) and math.abs(position.X - origin.X) < 90
				end)
				if target then
					goal = target:GetPivot().Position
					local distance = (Harness.Vector3.new(goal.X - here.X, 0, goal.Z - here.Z)).Magnitude
					if distance <= radius + 0.5 then
						bot.mode = "circle"; bot.center = Harness.Vector3.new(goal.X, 0, goal.Z)
						bot.angle = math.atan2(here.Z - goal.Z, here.X - goal.X); bot.swept = 0
						h:ribbonFor(player).ribbon = h.Loop.new(); bot.attempts += 1
					elseif distance > 9 and distance < 16 and e.now - bot.lastDash > 2.6 and options.dash ~= false then
						h:send(player, "Dash"); bot.lastDash = e.now; bot.dashes += 1
					end
				else
					goal = origin
				end
			end
			bot.wasCarry = s.carry
			e.walkToward(player, Harness.Vector3.new(goal.X, 3, goal.Z), options.speed or 21, dt)
		end
		if not active then
			if options.debug then
				for _, player in ipairs(playerList) do
					local st = h:state(player)
					print("DEBUG exit", player.Name, st and st.phase, st and st.remaining, bots[player].done, e.now)
				end
			end
			break
		end
		e.step(dt)
		for _, player in ipairs(playerList) do
			local bot = bots[player]
			local s = player.Parent and h:state(player)
			if s and s.phase == "Playing" and bot.mode ~= "bank" and bot.mode ~= "bank2" then
				if h:ribbonStep(player, s.biome) then
					bot.loops += 1
					if bot.mode == "circle" then bot.mode = "seek" end
				end
			end
			if s and bot.wasCarry then
				if s.carry > bot.wasCarry then bot.captures += s.carry - bot.wasCarry end
				if bot.wasCarry > 0 and s.carry == 0 and s.phase == "Playing" then bot.banks += 1 end
			end
			bot.wasCarry = nil
		end
	end
	return bots
end

-- Loop version of the old chase-and-catch: ring the nearest eligible creature.
function Harness.chaseAndCatch(h, player, filter, seconds)
	local started = h.engine.now
	while h.engine.now - started < (seconds or 8) do
		local here = h:position(player)
		local target = h:nearest(here, filter)
		if not target then h.engine.advance(0.2); continue end
		local carry = (h:state(player) or {}).carry or 0
		h:ringAround(player, target:GetPivot().Position, 5.5)
		h.engine.advance(0.3)
		if ((h:state(player) or {}).carry or 0) > carry then return true end
	end
	return false
end

-- Synchronized cycles: rounds auto-start at the next shared cycle boundary.
-- Advance virtual time until every listed player is in a scored round.
function Harness.awaitPlaying(h, playerList, timeout)
	local e = h.engine
	local deadline = e.now + (timeout or 20)
	while e.now < deadline do
		local all = true
		for _, player in ipairs(playerList) do
			local s = h:state(player)
			if not s or s.phase ~= "Playing" then all = false end
		end
		if all then return true end
		e.step(1 / 10)
	end
	return false
end

function Harness.assertClean(h, label)
	local e = h.engine
	-- Non-finite world geometry is always a defect (server math or harness).
	if h.world then
		for _, d in ipairs(h.world:GetDescendants()) do
			if d:IsA("BasePart") then
				local p = d.Position
				if p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z or math.abs(p.X) == math.huge then
					error((label or "scenario") .. ": non-finite position on " .. d:GetFullName(), 2)
				end
			end
		end
	end
	if #e.errors > 0 then
		for _, message in ipairs(e.errors) do print("ENGINE ERROR: " .. message) end
		error((label or "scenario") .. ": " .. #e.errors .. " engine/script errors", 2)
	end
end

function Harness.report(h, label)
	local e = h.engine
	print(string.format("INFO %s: t=%.1fs instances=%d created=%d destroyed=%d warnings=%d remoteIssues=%d analytics=%d",
		label, e.now, e.countInstances(), e.created, e.destroyedCount, #e.warnings, #e.remoteIssues, #e.analytics))
	for _, w in ipairs(e.warnings) do print("WARN " .. w) end
	for _, issue in ipairs(e.remoteIssues) do print("REMOTE " .. issue) end
end

return Harness
